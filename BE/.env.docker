# =====================================================
# Docker Environment Variables Template
# Copy this to .env in root directory for docker-compose
# =====================================================

# Server Configuration
NODE_ENV=production
PORT=3000

# Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_NAME=academic_collaboration_db
DB_USER=appuser
DB_PASSWORD=YourSecurePassword123!

# JWT Configuration
JWT_SECRET=your_super_secure_jwt_secret_key_min_32_characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_key_min_32_characters
JWT_REFRESH_EXPIRES_IN=30d

# Admin Default Account
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin123

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Email Configuration (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com

# phpMyAdmin Port (Optional)
PHPMYADMIN_PORT=8080

# OTP Configuration (Optional)
OTP_EXPIRE_MINUTES=1
