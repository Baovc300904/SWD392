{
    "info": {
        "name": "Test Register Topic For Group API",
        "_postman_id": "register-topic-group-api-test",
        "description": "Test cases for group registering a topic.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3000/api"
        },
        {
            "key": "token_member",
            "value": ""
        },
        {
            "key": "token_not_member",
            "value": ""
        },
        {
            "key": "groupId",
            "value": "2"
        },
        {
            "key": "topicId",
            "value": "1"
        }
    ],
    "item": [
        {
            "name": "Đăng ký thành công (thành viên nhóm)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token_member}}"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"groupId\": {{groupId}}\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/topics/{{topicId}}/register",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "topics",
                        "{{topicId}}",
                        "register"
                    ]
                }
            }
        },
        {
            "name": "Đăng ký thất bại (không phải thành viên nhóm)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token_not_member}}"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"groupId\": {{groupId}}\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/topics/{{topicId}}/register",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "topics",
                        "{{topicId}}",
                        "register"
                    ]
                }
            }
        },
        {
            "name": "Đăng ký thất bại (nhóm đã đăng ký đề tài)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token_member}}"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"groupId\": {{groupId}}\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/topics/{{topicId}}/register",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "topics",
                        "{{topicId}}",
                        "register"
                    ]
                }
            }
        },
        {
            "name": "Đăng ký thất bại (groupId không tồn tại)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token_member}}"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"groupId\": 99999\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/topics/{{topicId}}/register",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "topics",
                        "{{topicId}}",
                        "register"
                    ]
                }
            }
        },
        {
            "name": "Đăng ký thất bại (topicId không tồn tại)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token_member}}"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"groupId\": {{groupId}}\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/topics/99999/register",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "topics",
                        "99999",
                        "register"
                    ]
                }
            }
        },
        {
            "name": "Đăng ký thất bại (không truyền token)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"groupId\": {{groupId}}\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/topics/{{topicId}}/register",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "topics",
                        "{{topicId}}",
                        "register"
                    ]
                }
            }
        }
    ]
}