{
  "info": {
    "name": "SWD392 - Submissions API",
    "_postman_id": "a67d4d60-5acf-4ff7-8f4d-c789315e8f20",
    "description": "CRUD + Grade endpoints for submissions",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get all submissions",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/submissions?page=1&limit=20&status=SUBMITTED",
          "host": ["{{baseUrl}}"],
          "path": ["submissions"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "20" },
            { "key": "status", "value": "SUBMITTED" }
          ]
        }
      }
    },
    {
      "name": "Get submission by id",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/submissions/{{submissionId}}",
          "host": ["{{baseUrl}}"],
          "path": ["submissions", "{{submissionId}}"]
        }
      }
    },
    {
      "name": "Create submission",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"groupId\": 1,\n  \"milestoneName\": \"Milestone 2\",\n  \"fileUrl\": \"https://firebasestorage.googleapis.com/example\",\n  \"filePath\": \"submissions/1/1/ms2.zip\",\n  \"notes\": \"Nộp lần 1\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/submissions",
          "host": ["{{baseUrl}}"],
          "path": ["submissions"]
        }
      }
    },
    {
      "name": "Update submission",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"notes\": \"Nộp bản cập nhật\",\n  \"filePath\": \"submissions/1/1/ms2-v2.zip\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/submissions/{{submissionId}}",
          "host": ["{{baseUrl}}"],
          "path": ["submissions", "{{submissionId}}"]
        }
      }
    },
    {
      "name": "Delete submission",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/submissions/{{submissionId}}",
          "host": ["{{baseUrl}}"],
          "path": ["submissions", "{{submissionId}}"]
        }
      }
    },
    {
      "name": "Grade submission",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"grade\": 9.0,\n  \"feedback\": \"Làm tốt, cần bổ sung tài liệu test case.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/submissions/{{submissionId}}/grade",
          "host": ["{{baseUrl}}"],
          "path": ["submissions", "{{submissionId}}", "grade"]
        }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "token", "value": "" },
    { "key": "submissionId", "value": "1" }
  ]
}
